# Copy to .env and supply credentials for the existing infrastructure.
# Never commit the populated .env file.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=campusmind
POSTGRES_USER=campusmind
POSTGRES_PASSWORD=

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=campusmind

# Deterministic mode avoids paid embedding API calls in local validation.
RAG_EMBEDDING_PROVIDER=deterministic
LOCAL_BASE_URL=http://127.0.0.1:3006/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Only used when running scripts/seed_core.py or scripts/seed_demo.ps1.
CAMPUSMIND_DEMO_PASSWORD=
CAMPUSMIND_ADMIN_PASSWORD=
